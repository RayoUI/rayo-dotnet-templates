<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    <RootNamespace>RayoMvvmApp</RootNamespace>
    <AssemblyName>RayoMvvmApp</AssemblyName>
    <RayoVersion>0.1.10</RayoVersion>
    <SourceGeneratorNamespace>$(RootNamespace).Extensions</SourceGeneratorNamespace>
    <HotReloadEnabled Condition="'$(Configuration)' == 'Debug'">true</HotReloadEnabled>
    <HotReloadSupported Condition="'$(Configuration)' == 'Debug'">true</HotReloadSupported>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rayo" Version="$(RayoVersion)" />
    <PackageReference Include="Rayo.Hosting.Desktop" Version="$(RayoVersion)" />
    <PackageReference Include="Rayo.FluentApiGenerator" Version="$(RayoVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="SourceGeneratorNamespace" />
    <Compile Remove="Generated\**" />
  </ItemGroup>

</Project>
