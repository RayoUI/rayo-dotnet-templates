<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RayoCrossPlatformApp.Desktop</RootNamespace>
    <AssemblyName>RayoCrossPlatformApp.Desktop</AssemblyName>
    <RayoVersion>0.1.8</RayoVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RayoCrossPlatformApp\RayoCrossPlatformApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Rayo.Hosting.Desktop" Version="$(RayoVersion)" />
  </ItemGroup>

</Project>
