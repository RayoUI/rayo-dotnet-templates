<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Rayo.Templates</PackageId>
    <Version>0.1.8</Version>
    <Title>Rayo Templates</Title>
    <Description>dotnet new templates for creating Rayo desktop and cross-platform applications.</Description>
    <Authors>RayoUI</Authors>
    <PackageTags>dotnet-new;template;rayo;ui;desktop;android</PackageTags>
    <PackageType>Template</PackageType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="README.md" Pack="true" PackagePath="" />
    <Content Include="desktop\**\*" Pack="true" PackagePath="content\desktop" />
    <Content Include="crossplatform\**\*" Pack="true" PackagePath="content\crossplatform" />
  </ItemGroup>

</Project>
